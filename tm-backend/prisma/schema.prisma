// ==============================================================================
// QUY ƯỚC
// - Xóa mềm (deletedAt): NguoiDung, NhiemVu, DeTaiDeAn, MucTieu, PhieuDanhGia.
//   BoPhan dùng ngungHoatDong, VanBan dùng trangThai. Bảng phụ trợ và bảng nối xóa cứng theo cascade.
//
//   CREATE UNIQUE INDEX "ThanhVienBoPhan_mot_truong_moi_bo_phan"
//     ON "ThanhVienBoPhan" ("boPhanId")
//     WHERE "capBac" = 'TRUONG' AND "ngayKetThuc" IS NULL;
//
// (Cột capBac của ThanhVienBoPhan là bản sao từ VaiTro.capBac, do service điền lúc gán vai trò,
//  để chỉ mục có điều kiện kiểm tra được trong một bảng.)
//
// CÁC QUY TẮC KIỂM TRA Ở SERVICE (không khóa ở DB)
// - Vai trò gán cho thành viên phải có loaiBoPhan khớp với BoPhan.loai.
// - ThanhVienBoPhan.capBac phải bằng VaiTro.capBac của vaiTroId.
// - Số lượng tối đa mỗi vai trò trong một bộ phận theo VaiTro.soLuongToiDa.
// - Phó bắt buộc: kiểm tra khi mở kỳ đánh giá, không chặn lúc tạo bộ phận.
// - ThanhVienDeTai: đúng 1 chủ nhiệm. DeTaiDeAn cần >= 1 văn bản căn cứ trước khi kích hoạt.
// - Cây BoPhan không có vòng lặp; Ban Giám hiệu là gốc duy nhất.
// ==============================================================================

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// ─── ENUM ─────────────────────────────────────────────────────────────────────

enum NhomDonVi {
  DAO_TAO
  CHUC_NANG
  SU_NGHIEP
}

enum LoaiBoPhan {
  BAN_GIAM_HIEU
  KHOA
  BO_MON
  PHONG
  VIEN
  TRUNG_TAM
  THU_VIEN
  TRUONG //Trường
}

enum CapBac {
  TRUONG //Trưởng
  PHO // Phó
  THANH_VIEN //Giảng viên or nhân viên or ...
}

enum PhamViVaiTro {
  HE_THONG
  BO_PHAN
  DE_TAI
}

enum MucUuTien {
  THAP
  TRUNG_BINH
  CAO
  KHAN_CAP
}

enum NguonTaoNhiemVu {
  TU_DANG_KY
  DUOC_GIAO
}

enum LoaiDeTai {
  DE_TAI
  DE_AN
}

enum LoaiDauRa {
  TAI_LIEU
  LIEN_KET
  KHAC
}

enum TrangThaiMinhChung {
  CHO_DUYET
  DA_CHAP_NHAN
  BI_TRA_LAI
}

enum TrangThaiVanBan {
  CON_HIEU_LUC
  HET_HIEU_LUC
  DA_AN
}

enum LoaiPheDuyet { //Trừ cái giao việc từ trên xuống
  GIAO_NGANG
  DANG_KY
}

enum TrangThaiPheDuyet {
  CHO_DUYET
  DA_DUYET
  TU_CHOI
}

enum NhomChiSo {
  MUC_TIEU // nhập khi tạo nhiệm vụ (ví dụ muc_tieu)
  KET_QUA // nhập khi hoàn thành (ví dụ thuc_te)
}

enum CapApDungCongThuc {
  NHIEM_VU
  KY
}

enum KieuChamTieuChi {
  NHI_PHAN // đảm bảo hoặc không: đạt tối đa hoặc 0
  DIEM
}

// NHAP -> DA_NOP -> DANG_CHAM -> CHO_XAC_NHAN -> HOAN_TAT
// Phiếu của Trưởng gốc (Hiệu trưởng): nộp xong là HOAN_TAT.
enum TrangThaiPhieu {
  NHAP
  DA_NOP
  DANG_CHAM
  CHO_XAC_NHAN
  HOAN_TAT
}

enum LoaiNguoiCham {
  CHAM
  XAC_NHAN
}

enum LoaiNhapExcel {
  BO_PHAN
  NGUOI_DUNG
  NHIEM_VU
  DE_TAI
}

enum TrangThaiPhienNhap { //Phiên nhập
  XEM_TRUOC
  DA_DUYET
  DA_HUY
  LOI
}

// ─── NHÓM A: TỔ CHỨC VÀ PHÂN QUYỀN (7 bảng) ───────────────────────────────────

// Không có password (đăng nhập passwordless). Không lưu chức vụ Đảng và đoàn thể.
model NguoiDung {
  id         String    @id @default(uuid())
  email      String    @unique
  ten        String
  anhDaiDien String?
  ngaySinh   DateTime? @db.Date
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  vaiTroHeThong    NguoiDungVaiTro[]
  thanhVienBoPhan  ThanhVienBoPhan[]
  thanhVienDeTai   ThanhVienDeTai[]
  tepTinTaiLen     TepTin[]
  vanBanTaiLen     VanBan[]
  nhiemVuDaTao     NhiemVu[]              @relation("NhiemVuNguoiTao")
  nhiemVuThucHien  NhiemVuNguoiThucHien[] @relation("NguoiThucHien")
  nhiemVuDaGiao    NhiemVuNguoiThucHien[] @relation("NguoiGiao")
  pheDuyetDaYeuCau PheDuyetNhiemVu[]      @relation("PheDuyetNguoiYeuCau")
  pheDuyetDaXuLy   PheDuyetNhiemVu[]      @relation("PheDuyetNguoiDuyet")
  minhChungDaNop   MinhChung[]            @relation("MinhChungNguoiNop")
  minhChungDaDuyet MinhChung[]            @relation("MinhChungNguoiDuyet")
  phieuDanhGia     PhieuDanhGia[]         @relation("PhieuNguoiDuocDanhGia")
  phieuDaXacNhan   PhieuDanhGia[]         @relation("PhieuNguoiXacNhan")
  phieuDaCham      NguoiChamPhieu[]
  thongBao         ThongBao[]
  phienNhapExcel   PhienNhapExcel[]

  @@index([deletedAt])
}

// Mọi ô trong cây tổ chức (Ban Giám hiệu, Khoa, Bộ môn, Phòng, Viện, Trung tâm...).
// nhom: nhãn Đào tạo / Chức năng / Sự nghiệp, null cho Ban Giám hiệu.
// Bộ môn của một Khoa có boPhanChaId là Khoa đó; bộ môn độc lập có cha là Ban Giám hiệu.
model BoPhan {
  id            String     @id @default(uuid())
  ma            String     @unique
  ten           String
  loai          LoaiBoPhan
  nhom          NhomDonVi?
  boPhanChaId   String?
  ngungHoatDong Boolean    @default(false)
  thongTinThem  Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  boPhanCha BoPhan?  @relation("CayBoPhan", fields: [boPhanChaId], references: [id], onDelete: Restrict)
  boPhanCon BoPhan[] @relation("CayBoPhan")

  thanhVien      ThanhVienBoPhan[]
  vanBanQuanLy   VanBan[]
  deTaiChuTri    DeTaiDeAn[]
  deTaiPhoiHop   DeTaiBoPhan[]
  nhiemVuQuanLy  NhiemVu[]
  nhiemVuThayMat NhiemVuNguoiThucHien[]
  pheDuyetGiao   PheDuyetNhiemVu[]      @relation("PheDuyetBoPhanGiao")
  pheDuyetNhan   PheDuyetNhiemVu[]      @relation("PheDuyetBoPhanNhan")
  pheDuyetDuyet  PheDuyetNhiemVu[]      @relation("PheDuyetBoPhanDuyet")
  quyTrinh       QuyTrinh?
  mucTieu        MucTieu[]
  chiSo          ChiSo[]
  congThuc       CongThuc[]
  cauHinhKy      CauHinhKyBoPhan[]
  tieuChi        TieuChiDanhGia[]
  quyTacXepLoai  QuyTacXepLoai[]
  phieuDanhGia   PhieuDanhGia[]

  @@index([boPhanChaId])
  @@index([loai])
}

// Một người có thể thuộc nhiều bộ phận (kiêm nhiệm), mỗi bộ phận một vai trò.
// Đổi vai trò là sửa dòng, không lưu lịch sử vai trò.
model ThanhVienBoPhan {
  nguoiDungId String
  boPhanId    String
  vaiTroId    String
  capBac      CapBac
  ngayThamGia DateTime  @default(now())
  ngayKetThuc DateTime?

  nguoiDung NguoiDung @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade)
  boPhan    BoPhan    @relation(fields: [boPhanId], references: [id], onDelete: Cascade)
  vaiTro    VaiTro    @relation(fields: [vaiTroId], references: [id], onDelete: Restrict)

  @@id([nguoiDungId, boPhanId])
  @@index([boPhanId, capBac])
  @@index([vaiTroId])
}

// Vai trò KHÔNG dùng chung giữa các loại bộ phận; mỗi vai trò có bộ quyền riêng.
// ten chính là chức vụ hiển thị (Trưởng khoa, Phó phòng, Giảng viên...).
// capBac chỉ để thuật toán (chuỗi chấm, duyệt giao ngang) nhận biết cấp bậc.
// loaiBoPhan và capBac bắt buộc khi phamVi = BO_PHAN (kiểm tra ở service).
model VaiTro {
  id           String       @id @default(uuid())
  ma           String       @unique
  ten          String
  phamVi       PhamViVaiTro
  loaiBoPhan   LoaiBoPhan?
  capBac       CapBac?
  soLuongToiDa Int? // số người tối đa giữ vai trò này trong một bộ phận; null = không giới hạn
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  quyenHan         VaiTroQuyenHan[]
  nguoiDungHeThong NguoiDungVaiTro[]
  thanhVienBoPhan  ThanhVienBoPhan[]
  thanhVienDeTai   ThanhVienDeTai[]

  @@index([phamVi, loaiBoPhan])
}

model QuyenHan {
  id        String   @id @default(uuid())
  ma        String   @unique // ví dụ van_ban.tai_len
  moTa      String?
  createdAt DateTime @default(now())

  vaiTro VaiTroQuyenHan[]
}

// Quyền gắn cho vai trò, không gắn trực tiếp cho người.
model VaiTroQuyenHan {
  vaiTroId   String
  quyenHanId String

  vaiTro   VaiTro   @relation(fields: [vaiTroId], references: [id], onDelete: Cascade)
  quyenHan QuyenHan @relation(fields: [quyenHanId], references: [id], onDelete: Cascade)

  @@id([vaiTroId, quyenHanId])
}

// Chỉ dùng cho vai trò cấp hệ thống (ADMIN).
model NguoiDungVaiTro {
  nguoiDungId String
  vaiTroId    String

  nguoiDung NguoiDung @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade)
  vaiTro    VaiTro    @relation(fields: [vaiTroId], references: [id], onDelete: Cascade)

  @@id([nguoiDungId, vaiTroId])
}

// ─── NHÓM B: TỆP VÀ VĂN BẢN (5 bảng) ──────────────────────────────────────────

// Lưu khóa lưu trữ (key) chứ không lưu URL đầy đủ. Dùng chung cho văn bản và minh chứng.
model TepTin {
  id            String   @id @default(uuid())
  tenGoc        String
  mimeType      String
  kichThuoc     Int // byte
  khoaLuuTru    String //key URL
  nhaCungCap    String // ví dụ B2, SUPABASE. Có thể sẽ xài 2 thằng vì quá nghèo
  nguoiTaiLenId String
  taiLenLuc     DateTime @default(now())

  nguoiTaiLen NguoiDung   @relation(fields: [nguoiTaiLenId], references: [id], onDelete: Restrict)
  vanBan      VanBan[]
  minhChung   MinhChung[]

  @@unique([nhaCungCap, khoaLuuTru])
  @@index([nguoiTaiLenId])
}

// Danh sách cố định, người có thẩm quyền thêm bớt. Không xóa loại đang dùng (chỉ tắt dangDung).
model LoaiVanBan {
  id       String  @id @default(uuid())
  ma       String  @unique
  ten      String
  moTa     String?
  thuTu    Int     @default(0)
  dangDung Boolean @default(true)

  vanBan VanBan[]
}

// Mọi người xem được; tải lên cần quyền. Hiệu lực và phiên bản nằm trong file PDF,
// hệ thống chỉ giữ trangThai để người tải lên chỉnh khả năng hiển thị.
model VanBan {
  id             String          @id @default(uuid())
  soHieu         String?
  trichYeu       String
  loaiVanBanId   String
  coQuanBanHanh  String?
  ngayBanHanh    DateTime?       @db.Date
  boPhanQuanLyId String?
  tepTinId       String
  trangThai      TrangThaiVanBan @default(CON_HIEU_LUC)
  nguoiTaiLenId  String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  loaiVanBan   LoaiVanBan @relation(fields: [loaiVanBanId], references: [id], onDelete: Restrict)
  boPhanQuanLy BoPhan?    @relation(fields: [boPhanQuanLyId], references: [id], onDelete: SetNull)
  tepTin       TepTin     @relation(fields: [tepTinId], references: [id], onDelete: Restrict)
  nguoiTaiLen  NguoiDung  @relation(fields: [nguoiTaiLenId], references: [id], onDelete: Restrict)

  nhiemVu VanBanNhiemVu[]
  deTai   VanBanDeTai[]

  @@index([loaiVanBanId])
  @@index([trangThai])
  @@index([boPhanQuanLyId])
}

// Văn bản căn cứ giao việc, không bắt buộc với nhiệm vụ lẻ.
model VanBanNhiemVu {
  vanBanId  String
  nhiemVuId String

  vanBan  VanBan  @relation(fields: [vanBanId], references: [id], onDelete: Cascade)
  nhiemVu NhiemVu @relation(fields: [nhiemVuId], references: [id], onDelete: Cascade)

  @@id([vanBanId, nhiemVuId])
}

// Cần ít nhất 1 văn bản để kích hoạt đề tài/đề án (cờ cấu hình, kiểm tra ở service).
model VanBanDeTai {
  vanBanId String
  deTaiId  String

  vanBan VanBan    @relation(fields: [vanBanId], references: [id], onDelete: Cascade)
  deTai  DeTaiDeAn @relation(fields: [deTaiId], references: [id], onDelete: Cascade)

  @@id([vanBanId, deTaiId])
}

// ─── NHÓM C: ĐỀ TÀI/ĐỀ ÁN VÀ NHIỆM VỤ (8 bảng) ────────────────────────────────

// Một bảng cho cả đề tài và đề án; trường riêng từng loại nằm trong thongTinThem.
// ma tự sinh (ví dụ DT-2026-001). daKichHoat là đề xuất trong đặc tả.
model DeTaiDeAn {
  id             String    @id @default(uuid())
  ma             String    @unique
  ten            String
  moTa           String?
  loai           LoaiDeTai
  boPhanChuTriId String
  ngayBatDau     DateTime? @db.Date
  ngayKetThuc    DateTime? @db.Date
  daKichHoat     Boolean   @default(false)
  thongTinThem   Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  boPhanChuTri  BoPhan           @relation(fields: [boPhanChuTriId], references: [id], onDelete: Restrict)
  boPhanPhoiHop DeTaiBoPhan[]
  thanhVien     ThanhVienDeTai[]
  nhiemVu       NhiemVu[]
  vanBan        VanBanDeTai[]

  @@index([boPhanChuTriId])
  @@index([deletedAt])
}

// Các bộ phận phối hợp (đề tài liên bộ phận).
model DeTaiBoPhan {
  deTaiId  String
  boPhanId String

  deTai  DeTaiDeAn @relation(fields: [deTaiId], references: [id], onDelete: Cascade)
  boPhan BoPhan    @relation(fields: [boPhanId], references: [id], onDelete: Cascade)

  @@id([deTaiId, boPhanId])
}

// Đúng 1 chủ nhiệm (vaiTro CHU_NHIEM), kiểm tra ở service.
model ThanhVienDeTai {
  deTaiId     String
  nguoiDungId String
  vaiTroId    String

  deTai     DeTaiDeAn @relation(fields: [deTaiId], references: [id], onDelete: Cascade)
  nguoiDung NguoiDung @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade)
  vaiTro    VaiTro    @relation(fields: [vaiTroId], references: [id], onDelete: Restrict)

  @@id([deTaiId, nguoiDungId])
}

// buocQuyTrinhId là trạng thái TỔNG; trạng thái riêng từng người nằm ở NhiemVuNguoiThucHien.
// deTaiId null = nhiệm vụ lẻ. coHieuLuc = false khi đang chờ duyệt (đề xuất).
// moTaKpi mô tả KPI bằng chữ (ví dụ "lập được thời khóa biểu cho DH24PM").
model NhiemVu {
  id             String          @id @default(uuid())
  ma             String          @unique
  tieuDe         String
  moTa           String?
  mucUuTien      MucUuTien       @default(TRUNG_BINH)
  hanHoanThanh   DateTime?
  nguonTao       NguonTaoNhiemVu @default(DUOC_GIAO)
  moTaKpi        String?
  thongTinThem   Json?
  boPhanQuanLyId String
  deTaiId        String?
  nhiemVuChaId   String?
  nguoiTaoId     String
  congThucId     String?
  buocQuyTrinhId String?
  coHieuLuc      Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  boPhanQuanLy BoPhan        @relation(fields: [boPhanQuanLyId], references: [id], onDelete: Restrict)
  deTai        DeTaiDeAn?    @relation(fields: [deTaiId], references: [id], onDelete: Restrict)
  nhiemVuCha   NhiemVu?      @relation("CayNhiemVu", fields: [nhiemVuChaId], references: [id], onDelete: Cascade)
  nhiemVuCon   NhiemVu[]     @relation("CayNhiemVu")
  nguoiTao     NguoiDung     @relation("NhiemVuNguoiTao", fields: [nguoiTaoId], references: [id], onDelete: Restrict)
  congThuc     CongThuc?     @relation(fields: [congThucId], references: [id], onDelete: Restrict)
  buocQuyTrinh BuocQuyTrinh? @relation("NhiemVuBuocTong", fields: [buocQuyTrinhId], references: [id], onDelete: Restrict)

  nguoiThucHien NhiemVuNguoiThucHien[]
  pheDuyet      PheDuyetNhiemVu[]
  dauRa         DauRaNhiemVu[]
  vanBan        VanBanNhiemVu[]
  ketQuaChinh   NhiemVuKetQuaChinh[]

  @@index([boPhanQuanLyId, deTaiId])
  @@index([nhiemVuChaId])
  @@index([hanHoanThanh])
  @@index([deletedAt])
}

// Trạng thái và KPI theo từng người. boPhanId = người này làm thay mặt bộ phận nào.
model NhiemVuNguoiThucHien {
  nhiemVuId      String
  nguoiDungId    String
  boPhanId       String
  buocQuyTrinhId String?
  nguoiGiaoId    String?
  ngayGiao       DateTime  @default(now())
  ngayHoanThanh  DateTime?

  nhiemVu      NhiemVu       @relation(fields: [nhiemVuId], references: [id], onDelete: Cascade)
  nguoiDung    NguoiDung     @relation("NguoiThucHien", fields: [nguoiDungId], references: [id], onDelete: Cascade)
  boPhan       BoPhan        @relation(fields: [boPhanId], references: [id], onDelete: Restrict)
  buocQuyTrinh BuocQuyTrinh? @relation("NguoiThucHienBuoc", fields: [buocQuyTrinhId], references: [id], onDelete: Restrict)
  nguoiGiao    NguoiDung?    @relation("NguoiGiao", fields: [nguoiGiaoId], references: [id], onDelete: SetNull)

  giaTriChiSo GiaTriChiSo[]
  kpiChot     KpiChot?

  @@id([nhiemVuId, nguoiDungId])
  @@index([nguoiDungId])
  @@index([boPhanId])
}

// Lưu lịch sử từng lần (từ chối rồi gửi lại). Dùng cho giao ngang và tự đăng ký.
// GIAO_NGANG: boPhanDuyetId = bộ phận tổ tiên chung gần nhất của hai bên.
// DANG_KY: boPhanGiaoId và boPhanNhanId để trống, boPhanDuyetId = bộ phận quản lý nhiệm vụ.
model PheDuyetNhiemVu {
  id             String            @id @default(uuid())
  nhiemVuId      String
  loai           LoaiPheDuyet
  boPhanGiaoId   String?
  boPhanNhanId   String?
  boPhanDuyetId  String
  trangThai      TrangThaiPheDuyet @default(CHO_DUYET)
  nguoiYeuCauId  String
  nguoiDuyetId   String?
  lyDo           String?
  thoiGianYeuCau DateTime          @default(now())
  thoiGianXuLy   DateTime?

  nhiemVu     NhiemVu    @relation(fields: [nhiemVuId], references: [id], onDelete: Cascade)
  boPhanGiao  BoPhan?    @relation("PheDuyetBoPhanGiao", fields: [boPhanGiaoId], references: [id], onDelete: Restrict)
  boPhanNhan  BoPhan?    @relation("PheDuyetBoPhanNhan", fields: [boPhanNhanId], references: [id], onDelete: Restrict)
  boPhanDuyet BoPhan     @relation("PheDuyetBoPhanDuyet", fields: [boPhanDuyetId], references: [id], onDelete: Restrict)
  nguoiYeuCau NguoiDung  @relation("PheDuyetNguoiYeuCau", fields: [nguoiYeuCauId], references: [id], onDelete: Restrict)
  nguoiDuyet  NguoiDung? @relation("PheDuyetNguoiDuyet", fields: [nguoiDuyetId], references: [id], onDelete: SetNull)

  @@index([nhiemVuId])
  @@index([boPhanDuyetId, trangThai])
}

model DauRaNhiemVu {
  id        String    @id @default(uuid())
  nhiemVuId String
  tieuDe    String
  moTa      String?
  loaiDauRa LoaiDauRa @default(TAI_LIEU)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  nhiemVu   NhiemVu     @relation(fields: [nhiemVuId], references: [id], onDelete: Cascade)
  minhChung MinhChung[]

  @@index([nhiemVuId])
}

// Không được xóa khi trangThai = DA_CHAP_NHAN (kiểm tra ở service).
model MinhChung {
  id           String             @id @default(uuid())
  dauRaId      String
  tepTinId     String
  trangThai    TrangThaiMinhChung @default(CHO_DUYET)
  ghiChuDuyet  String?
  nguoiNopId   String
  nopLuc       DateTime           @default(now())
  nguoiDuyetId String?
  duyetLuc     DateTime?

  dauRa      DauRaNhiemVu @relation(fields: [dauRaId], references: [id], onDelete: Cascade)
  tepTin     TepTin       @relation(fields: [tepTinId], references: [id], onDelete: Restrict)
  nguoiNop   NguoiDung    @relation("MinhChungNguoiNop", fields: [nguoiNopId], references: [id], onDelete: Restrict)
  nguoiDuyet NguoiDung?   @relation("MinhChungNguoiDuyet", fields: [nguoiDuyetId], references: [id], onDelete: SetNull)

  @@index([dauRaId])
  @@index([trangThai])
}

// ─── NHÓM D: QUY TRÌNH TRẠNG THÁI (3 bảng) ────────────────────────────────────

// Mỗi bộ phận một quy trình (boPhanId duy nhất). boPhanId null = bản mẫu của ADMIN để
// sao chép khi tạo bộ phận mới (đề xuất, chờ quyết định D2).
model QuyTrinh {
  id        String   @id @default(uuid())
  ten       String
  moTa      String?
  boPhanId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boPhan     BoPhan?        @relation(fields: [boPhanId], references: [id], onDelete: Cascade)
  buoc       BuocQuyTrinh[]
  chuyenBuoc ChuyenBuoc[]
}

// Không xóa bước đang có nhiệm vụ dùng (onDelete Restrict ở NhiemVu và NhiemVuNguoiThucHien).
model BuocQuyTrinh {
  id         String  @id @default(uuid())
  quyTrinhId String
  ten        String // TODO, IN_PROGRESS, REVIEW, DONE...
  nhan       String // nhãn hiển thị: chưa làm, đang làm...
  laBuocDau  Boolean @default(false)
  laBuocCuoi Boolean @default(false)
  mau        String?
  thuTu      Int     @default(0)

  quyTrinh      QuyTrinh               @relation(fields: [quyTrinhId], references: [id], onDelete: Cascade)
  chuyenTu      ChuyenBuoc[]           @relation("ChuyenTuBuoc")
  chuyenDen     ChuyenBuoc[]           @relation("ChuyenDenBuoc")
  nhiemVuTong   NhiemVu[]              @relation("NhiemVuBuocTong")
  nguoiThucHien NhiemVuNguoiThucHien[] @relation("NguoiThucHienBuoc")

  @@unique([quyTrinhId, ten])
  @@index([quyTrinhId, thuTu])
}

model ChuyenBuoc {
  id         String  @id @default(uuid())
  quyTrinhId String
  tuBuocId   String
  denBuocId  String
  nhan       String?

  quyTrinh QuyTrinh     @relation(fields: [quyTrinhId], references: [id], onDelete: Cascade)
  tuBuoc   BuocQuyTrinh @relation("ChuyenTuBuoc", fields: [tuBuocId], references: [id], onDelete: Cascade)
  denBuoc  BuocQuyTrinh @relation("ChuyenDenBuoc", fields: [denBuocId], references: [id], onDelete: Cascade)

  @@unique([quyTrinhId, tuBuocId, denBuocId])
}

// ─── NHÓM E: OKR THEO BỘ PHẬN (3 bảng) ────────────────────────────────────────

model MucTieu {
  id          String    @id @default(uuid())
  tieuDe      String
  moTa        String?
  ngayBatDau  DateTime? @db.Date
  ngayKetThuc DateTime? @db.Date
  boPhanId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  boPhan      BoPhan        @relation(fields: [boPhanId], references: [id], onDelete: Restrict)
  ketQuaChinh KetQuaChinh[]

  @@index([boPhanId])
  @@index([deletedAt])
}

model KetQuaChinh {
  id            String   @id @default(uuid())
  mucTieuId     String
  tieuDe        String
  moTa          String?
  giaTriBatDau  Float    @default(0)
  giaTriHienTai Float    @default(0)
  giaTriMucTieu Float
  donViDo       String? // đơn vị đo (tránh nhầm với "đơn vị" là nhóm)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mucTieu MucTieu              @relation(fields: [mucTieuId], references: [id], onDelete: Cascade)
  nhiemVu NhiemVuKetQuaChinh[]

  @@index([mucTieuId])
}

model NhiemVuKetQuaChinh {
  nhiemVuId     String
  ketQuaChinhId String

  nhiemVu     NhiemVu     @relation(fields: [nhiemVuId], references: [id], onDelete: Cascade)
  ketQuaChinh KetQuaChinh @relation(fields: [ketQuaChinhId], references: [id], onDelete: Cascade)

  @@id([nhiemVuId, ketQuaChinhId])
}

// ─── NHÓM F: KPI ĐỘNG (4 bảng) ────────────────────────────────────────────────

// Chỉ số do từng bộ phận định nghĩa (điểm chuẩn, hệ số, mục tiêu, thực tế, tiến độ, chất lượng...).
// khoa là khóa dùng trong công thức (ví dụ muc_tieu, thuc_te). Không xóa khi đang dùng.
model ChiSo {
  id        String    @id @default(uuid())
  boPhanId  String
  khoa      String
  ten       String
  moTa      String?
  donViDo   String?
  nhom      NhomChiSo
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  boPhan      BoPhan        @relation(fields: [boPhanId], references: [id], onDelete: Cascade)
  giaTriChiSo GiaTriChiSo[]

  @@unique([boPhanId, khoa])
}

// Hai tầng công thức: NHIEM_VU (từng nhiệm vụ cho từng người) và KY (tổng hợp KPI kỳ).
// bieuThucToiDa là đề xuất: biểu thức tính điểm tối đa của nhiệm vụ (chốt ở S7, xem đặc tả mục 9).
model CongThuc {
  id            String            @id @default(uuid())
  boPhanId      String
  ten           String
  bieuThuc      String // ví dụ diem_chuan * min(thuc_te / muc_tieu, 1)
  bieuThucToiDa String?
  moTa          String?
  phienBan      Int               @default(1)
  capApDung     CapApDungCongThuc @default(NHIEM_VU)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  boPhan    BoPhan            @relation(fields: [boPhanId], references: [id], onDelete: Cascade)
  nhiemVu   NhiemVu[]
  cauHinhKy CauHinhKyBoPhan[] @relation("CongThucKy")

  @@index([boPhanId, capApDung])
}

// Giá trị chỉ số theo từng người thực hiện (khóa ngoại ghép tới NhiemVuNguoiThucHien).
// Mục tiêu nhập một lần cho nhiệm vụ rồi chép cho từng người (đề xuất, xử lý ở service).
model GiaTriChiSo {
  id          String @id @default(uuid())
  nhiemVuId   String
  nguoiDungId String
  chiSoId     String
  giaTri      Float  @default(0)

  nguoiThucHien NhiemVuNguoiThucHien @relation(fields: [nhiemVuId, nguoiDungId], references: [nhiemVuId, nguoiDungId], onDelete: Cascade)
  chiSo         ChiSo                @relation(fields: [chiSoId], references: [id], onDelete: Restrict)

  @@unique([nhiemVuId, nguoiDungId, chiSoId])
}

// Bản chụp mỗi lần chốt KPI: công thức, phiên bản và giá trị chỉ số tại thời điểm tính.
// Không cho gỡ người thực hiện đã có KPI chốt (onDelete Restrict).
model KpiChot {
  id            String   @id @default(uuid())
  nhiemVuId     String
  nguoiDungId   String
  diemDat       Float
  diemToiDa     Float
  bieuThuc      String
  bieuThucToiDa String?
  phienBan      Int
  giaTriChiSo   Json
  tinhLuc       DateTime @default(now())

  nguoiThucHien NhiemVuNguoiThucHien @relation(fields: [nhiemVuId, nguoiDungId], references: [nhiemVuId, nguoiDungId], onDelete: Restrict)

  @@unique([nhiemVuId, nguoiDungId])
}

// ─── NHÓM G: ĐÁNH GIÁ (8 bảng) ────────────────────────────────────────────────

// Kỳ dùng chung toàn trường. Tỷ trọng mặc định là nháp, sửa được; cấu hình thật theo
// (kỳ, bộ phận) ở CauHinhKyBoPhan.
model KyDanhGia {
  id                    String   @id @default(uuid())
  ten                   String
  ngayBatDau            DateTime @db.Date
  ngayKetThuc           DateTime @db.Date
  tyTrongKpiMacDinh     Float    @default(0.6)
  tyTrongTieuChiMacDinh Float    @default(0.4)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  cauHinh CauHinhKyBoPhan[]
  tieuChi TieuChiDanhGia[]
  phieu   PhieuDanhGia[]
}

// Tổng hai tỷ trọng bằng 1 (kiểm tra ở service). congThucKyId = công thức tổng hợp KPI kỳ.
model CauHinhKyBoPhan {
  kyId           String
  boPhanId       String
  tyTrongKpi     Float
  tyTrongTieuChi Float
  congThucKyId   String?

  ky         KyDanhGia @relation(fields: [kyId], references: [id], onDelete: Cascade)
  boPhan     BoPhan    @relation(fields: [boPhanId], references: [id], onDelete: Cascade)
  congThucKy CongThuc? @relation("CongThucKy", fields: [congThucKyId], references: [id], onDelete: SetNull)

  @@id([kyId, boPhanId])
}

// Phân cấp (nhóm tiêu chí và tiêu chí). Nhóm cha có thể để diemToiDa = 0 (tự cộng từ con).
model TieuChiDanhGia {
  id           String          @id @default(uuid())
  kyId         String
  boPhanId     String
  tieuChiChaId String?
  ten          String
  moTa         String?
  kieuCham     KieuChamTieuChi @default(DIEM)
  diemToiDa    Float           @default(0)
  thuTu        Int             @default(0)

  ky         KyDanhGia        @relation(fields: [kyId], references: [id], onDelete: Cascade)
  boPhan     BoPhan           @relation(fields: [boPhanId], references: [id], onDelete: Cascade)
  tieuChiCha TieuChiDanhGia?  @relation("CayTieuChi", fields: [tieuChiChaId], references: [id], onDelete: Cascade)
  tieuChiCon TieuChiDanhGia[] @relation("CayTieuChi")

  ketQuaTuDanhGia KetQuaTuDanhGia[]
  diemCham        DiemChamTieuChi[]

  @@index([kyId, boPhanId])
}

// Ví dụ 4 mức: hoàn thành xuất sắc, tốt, hoàn thành, không hoàn thành. Ngưỡng do ADMIN cấu hình.
model QuyTacXepLoai {
  id        String   @id @default(uuid())
  boPhanId  String
  grade     String
  nhan      String
  diemTu    Float
  diemDen   Float
  moTa      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boPhan BoPhan @relation(fields: [boPhanId], references: [id], onDelete: Cascade)

  @@unique([boPhanId, grade])
}

// Mỗi người một phiếu cho mỗi bộ phận họ thuộc (kiêm nhiệm 2 bộ phận có 2 phiếu).
model PhieuDanhGia {
  id             String         @id @default(uuid())
  kyId           String
  nguoiDungId    String
  boPhanId       String
  trangThai      TrangThaiPhieu @default(NHAP)
  diemKpi        Float          @default(0)
  diemTieuChi    Float          @default(0)
  diemTong       Float          @default(0)
  xepLoai        String?
  tuNhanXet      String?
  nguoiXacNhanId String?
  xacNhanLuc     DateTime?
  nhanXetXacNhan String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  ky           KyDanhGia  @relation(fields: [kyId], references: [id], onDelete: Cascade)
  nguoiDung    NguoiDung  @relation("PhieuNguoiDuocDanhGia", fields: [nguoiDungId], references: [id], onDelete: Restrict)
  boPhan       BoPhan     @relation(fields: [boPhanId], references: [id], onDelete: Restrict)
  nguoiXacNhan NguoiDung? @relation("PhieuNguoiXacNhan", fields: [nguoiXacNhanId], references: [id], onDelete: SetNull)

  ketQuaTuDanhGia KetQuaTuDanhGia[]
  nguoiCham       NguoiChamPhieu[]

  @@unique([kyId, nguoiDungId, boPhanId])
  @@index([nguoiDungId])
  @@index([boPhanId, trangThai])
}

model KetQuaTuDanhGia {
  phieuId    String
  tieuChiId  String
  diemTuCham Float    @default(0)
  damBao     Boolean? // dùng cho tiêu chí kiểu NHI_PHAN
  nhanXet    String?

  phieu   PhieuDanhGia   @relation(fields: [phieuId], references: [id], onDelete: Cascade)
  tieuChi TieuChiDanhGia @relation(fields: [tieuChiId], references: [id], onDelete: Cascade)

  @@id([phieuId, tieuChiId])
}

// Lưu lại người chấm đã được suy ra từ cây tổ chức và cấp bậc.
// Một người có thể vừa CHAM vừa XAC_NHAN trên cùng một phiếu (hai dòng khác loai).
model NguoiChamPhieu {
  id          String        @id @default(uuid())
  phieuId     String
  nguoiChamId String
  loai        LoaiNguoiCham
  nhanXet     String?
  chamLuc     DateTime?
  createdAt   DateTime      @default(now())

  phieu     PhieuDanhGia @relation(fields: [phieuId], references: [id], onDelete: Cascade)
  nguoiCham NguoiDung    @relation(fields: [nguoiChamId], references: [id], onDelete: Restrict)

  diem DiemChamTieuChi[]

  @@unique([phieuId, nguoiChamId, loai])
  @@index([nguoiChamId])
}

model DiemChamTieuChi {
  nguoiChamPhieuId String
  tieuChiId        String
  diem             Float   @default(0)
  nhanXet          String?

  nguoiChamPhieu NguoiChamPhieu @relation(fields: [nguoiChamPhieuId], references: [id], onDelete: Cascade)
  tieuChi        TieuChiDanhGia @relation(fields: [tieuChiId], references: [id], onDelete: Cascade)

  @@id([nguoiChamPhieuId, tieuChiId])
}

// ─── NHÓM H: THÔNG BÁO VÀ IMPORT EXCEL (2 bảng) ───────────────────────────────

// Thông báo trong ứng dụng; email gửi kèm theo sự kiện. loai dạng chuỗi vì danh sách sự kiện
// (D4) chưa chốt.
model ThongBao {
  id          String   @id @default(uuid())
  nguoiNhanId String
  loai        String
  tieuDe      String
  noiDung     String?
  duongDan    String?
  daDoc       Boolean  @default(false)
  daGuiEmail  Boolean  @default(false)
  taoLuc      DateTime @default(now())

  nguoiNhan NguoiDung @relation(fields: [nguoiNhanId], references: [id], onDelete: Cascade)

  @@index([nguoiNhanId, daDoc, taoLuc])
}

// Giữ dữ liệu giữa bước xem trước và bước duyệt. File có bất kỳ lỗi nào thì trangThai = LOI
// và không được duyệt.
model PhienNhapExcel {
  id             String             @id @default(uuid())
  loai           LoaiNhapExcel
  nguoiTaoId     String
  tenFile        String
  trangThai      TrangThaiPhienNhap @default(XEM_TRUOC)
  duLieuXemTruoc Json?
  loi            Json?
  tomTat         Json?
  taoLuc         DateTime           @default(now())
  hetHanLuc      DateTime
  duyetLuc       DateTime?

  nguoiTao NguoiDung @relation(fields: [nguoiTaoId], references: [id], onDelete: Cascade)

  @@index([nguoiTaoId, trangThai])
}
